<div class="ad-card">
  <div class="ad-card-header">
    <span class="ad-card-title"><%- @T('∅ Waiting time today') %></span>
    <div class="ad-card-icon">
      <%- @Icon('stopwatch') %>
    </div>
  </div>
  <div class="ad-card-value">
    <%- @StatsTicketWaitingTime?.handling_time || 0 %>m
  </div>
  <div class="ad-card-subtitle">
    <%- @T('My handling time: %s minutes', @StatsTicketWaitingTime?.handling_time || 0) %>
  </div>
  <div class="ad-card-detail">
    <%- @T('Average: %s minutes', @StatsTicketWaitingTime?.average_per_agent || 0) %>
  </div>
</div>
