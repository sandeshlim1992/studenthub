<div class="ad-card">
  <div class="ad-card-header">
    <span class="ad-card-title"><%- @T('Mood') %></span>
    <div class="ad-card-icon">
      <%- @Icon("mood-#{@StatsTicketEscalation?.state || 'good'}") %>
    </div>
  </div>
  <div class="ad-card-value capitalize">
    <%- @StatsTicketEscalation?.state || 'Good' %>
  </div>
  <div class="ad-card-subtitle">
    <%- @T('%s of my tickets escalated', @StatsTicketEscalation?.own || 0) %>
  </div>
  <div class="ad-card-detail">
    <%- @T('Total: %s', @StatsTicketEscalation?.total || 0) %>
  </div>
</div>
