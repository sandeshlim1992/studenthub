<style>
body,
html,
#loading-app,
#app[data-loaded="true"] {
  height: 100%;
}
html {
  background-color: var(--background-primary);
}
body,
html {
  margin: 0;
  font-family: 'Fira Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 16px;
  line-height: 21px;
}
#loading-app {
  display: flex;
}
.loading-animation {
  margin: 0 auto;
  display: block;
  vertical-align: middle;
}
.loading-animation.error {
  filter: blur(1px);
}
.loading-animation.error * {
  animation: none !important;
}
.loading-main {
  margin: auto;
}
.loading-sr-text {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
.loading-failed {
  position: relative;
  opacity: 0;
  color: var(--text-contrast);
  width: 175px;
  text-align: center;
  margin-top: -52px;
  transition: opacity 0.5s;
  font-weight: 600;
}
.loading-failed.active {
  opacity: 1;
}
.noscript-message {
  color: var(--text-contrast);
  text-align: center;
  font-weight: 600;
  margin-top: -52px;
}
</style>
<div id="loading-app" style="position: fixed; inset: 0; background: #0F1729; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 9999; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; overflow: hidden;">
  <!-- Background blobs matching login screen -->
  <div style="position: absolute; top: -50%; right: -25%; width: 800px; height: 800px; background: rgba(59,130,246,0.2); border-radius: 50%; filter: blur(120px); pointer-events: none;"></div>
  <div style="position: absolute; bottom: -50%; left: -25%; width: 600px; height: 600px; background: rgba(96,165,250,0.2); border-radius: 50%; filter: blur(100px); pointer-events: none;"></div>

  <!-- Logo card -->
  <div class="student-logo-card">
    <img 
      src="/assets/images/branding/student_hub_logo.png"
      style="width: 100%; height: 100%; object-fit: contain;"
      alt="Student Hub"
    />
  </div>

  <div style="text-align: center; display: flex; flex-direction: column; gap: 0.3rem; margin-top: 1.5rem; position: relative; z-index: 1;">
    <span style="font-size: 0.8125rem; color: #ffffff; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; margin: 0;">STUDENT HUB</span>
    <span style="font-size: 0.6875rem; color: #94a3b8; font-weight: 500; margin: 0;">Loading...</span>
  </div>

  <div class="loading-sr-text">
    <%= Translation.translate(local_assigns[:locale], 'Loading…') %>
  </div>
  <div class="loading-failed" aria-hidden="true">
    <%= Translation.translate(local_assigns[:locale], 'Loading failed, please try again later.') %>
  </div>
  <noscript>
    <div style="margin-top: 16px; color: #ffffff;">
      <%= Translation.translate(local_assigns[:locale], 'Turn on JavaScript to use Student Hub.') %>
    </div>
  </noscript>
</div>
<style>
  .student-logo-card {
    position: relative;
    z-index: 1;
    width: 160px;
    height: 160px;
    background: linear-gradient(145deg, #ffffff 0%, #f0f7ff 60%, #e8f2ff 100%);
    border-radius: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px;
    box-shadow:
      0 25px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 0 40px rgba(59, 130, 246, 0.4),
      0 0 80px rgba(59, 130, 246, 0.18);
    animation: glowPulse 2.6s ease-in-out infinite;
    will-change: box-shadow;
    transform: translateZ(0);
  }
  @keyframes glowPulse {
    0%, 100% {
      box-shadow:
        0 25px 60px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.12),
        0 0 40px rgba(59, 130, 246, 0.4),
        0 0 80px rgba(59, 130, 246, 0.18);
    }
    50% {
      box-shadow:
        0 30px 70px rgba(0, 0, 0, 0.6),
        0 0 0 1px rgba(255, 255, 255, 0.2),
        0 0 65px rgba(59, 130, 246, 0.7),
        0 0 120px rgba(59, 130, 246, 0.35),
        0 0 180px rgba(59, 130, 246, 0.12);
    }
  }
</style>
