<div class="dashboard main ad-dashboard">
  <div class="ad-tabs tabs">
    <div class="ad-tab-group">
      <div class="ad-tab tab active" data-area="stat-widgets"><%- @T('My Stats') %></div>
      <div class="ad-tab tab" data-area="first-steps-widgets"><%- @T('First Steps') %></div>
    </div>
    <div class="ad-bell-wrapper">
      <button class="ad-bell-toggle-btn js-toggle-activity-stream active" title="Toggle Live Activity Stream">
        <span class="ad-bell-icon-wrapper">
          <%- @Icon('bell', 'ad-bell-icon') %>
          <span class="ad-bell-pulse"></span>
        </span>
        <span class="ad-bell-label">Activity Feed</span>
      </button>
    </div>
  </div>
  <div class="tab-content first-steps-widgets hidden"></div>

  <!-- Real Zammad Stat Widgets Grid -->
  <div class="tab-content stat-widgets ad-grid"></div>

  <!-- Interactive Charts Section -->
  <div class="tab-content stat-widgets ad-charts-row">
    <!-- Line Chart Card -->
    <div class="ad-chart-card js-line-chart-card">
      <div class="ad-chart-header">
        <h3 class="ad-chart-title"><%- @T('Tickets Opened vs. Closed (Month by Month)') %></h3>
        <div class="ad-chart-actions">
          <span class="ad-chart-pill active" data-period="30d">30D</span>
          <span class="ad-chart-pill" data-period="90d">90D</span>
          <span class="ad-chart-tag">Line Chart</span>
        </div>
      </div>
      <div class="ad-chart-legend">
        <div class="ad-legend-item" data-series="opened">
          <span class="ad-legend-indicator ad-legend-line--primary"></span>
          <span>Tickets Opened</span>
        </div>
        <div class="ad-legend-item" data-series="closed">
          <span class="ad-legend-indicator ad-legend-line--secondary"></span>
          <span>Tickets Closed</span>
        </div>
      </div>
      <div class="ad-chart-wrapper">
        <div class="ad-chart-tooltip js-line-tooltip hidden">
          <div class="ad-tooltip-date">Oct 21</div>
          <div class="ad-tooltip-row">
            <span class="ad-tooltip-dot ad-bg-primary"></span>
            <span>Opened:</span>
            <strong class="js-val-opened">18,452</strong>
          </div>
          <div class="ad-tooltip-row">
            <span class="ad-tooltip-dot ad-bg-secondary"></span>
            <span>Closed:</span>
            <strong class="js-val-closed">15,180</strong>
          </div>
        </div>
        <svg class="ad-chart-svg js-line-svg" viewBox="0 0 500 180" preserveAspectRatio="none">
          <defs>
            <linearGradient id="userGrowthGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2563eb" stop-opacity="0.3"/>
              <stop offset="100%" stop-color="#2563eb" stop-opacity="0.0"/>
            </linearGradient>
            <linearGradient id="activeGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.2"/>
              <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.0"/>
            </linearGradient>
          </defs>
          <line class="ad-hover-line js-hover-line hidden" x1="0" y1="0" x2="0" y2="180" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 3"/>
          <path class="js-path-growth-area" d="M0,150 Q60,110 120,80 T240,45 T360,20 T480,30 L480,180 L0,180 Z" fill="url(#userGrowthGrad)" />
          <path class="js-path-growth" d="M0,150 Q60,110 120,80 T240,45 T360,20 T480,30" fill="none" stroke="#2563eb" stroke-width="3" />
          <path class="js-path-active" d="M0,165 Q60,135 120,115 T240,90 T360,65 T480,55" fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-dasharray="0" />
          
          <!-- Helpdesk Ticketing Interactive Data Points -->
          <circle class="ad-chart-point js-point" cx="0" cy="150" r="5" data-date="Oct 1" data-opened="4,200" data-closed="3,800"/>
          <circle class="ad-chart-point js-point" cx="45" cy="135" r="5" data-date="Oct 5" data-opened="6,800" data-closed="5,900"/>
          <circle class="ad-chart-point js-point" cx="90" cy="110" r="5" data-date="Oct 7" data-opened="9,400" data-closed="8,300"/>
          <circle class="ad-chart-point js-point" cx="135" cy="85" r="5" data-date="Oct 9" data-opened="11,200" data-closed="9,700"/>
          <circle class="ad-chart-point js-point" cx="180" cy="70" r="5" data-date="Oct 11" data-opened="13,500" data-closed="11,600"/>
          <circle class="ad-chart-point js-point" cx="225" cy="55" r="5" data-date="Oct 13" data-opened="15,100" data-closed="13,200"/>
          <circle class="ad-chart-point js-point" cx="270" cy="40" r="5" data-date="Oct 17" data-opened="16,800" data-closed="14,100"/>
          <circle class="ad-chart-point js-point" cx="315" cy="30" r="5" data-date="Oct 19" data-opened="17,900" data-closed="14,800"/>
          <circle class="ad-chart-point js-point active" cx="360" cy="20" r="6" data-date="Oct 21" data-opened="18,452" data-closed="15,180"/>
          <circle class="ad-chart-point js-point" cx="405" cy="24" r="5" data-date="Oct 25" data-opened="18,100" data-closed="15,050"/>
          <circle class="ad-chart-point js-point" cx="450" cy="28" r="5" data-date="Oct 27" data-opened="18,300" data-closed="15,200"/>
          <circle class="ad-chart-point js-point" cx="495" cy="30" r="5" data-date="Oct 31" data-opened="18,452" data-closed="15,350"/>
        </svg>
      </div>
      <div class="ad-x-axis">
        <span>Oct 1</span><span>5</span><span>7</span><span>9</span><span>11</span><span>13</span><span>17</span><span>19</span><span>21</span><span>25</span><span>27</span><span>Oct 31</span>
      </div>
    </div>

    <!-- Bar Chart Card -->
    <div class="ad-chart-card js-bar-chart-card">
      <div class="ad-chart-header">
        <h3 class="ad-chart-title"><%- @T('Tickets by Priority') %></h3>
        <div class="ad-chart-actions">
          <span class="ad-chart-tag">Bar Chart</span>
        </div>
      </div>
      <div class="ad-chart-legend">
        <div class="ad-legend-item" data-series="high">
          <span class="ad-legend-indicator ad-legend-box--primary"></span>
          <span>High / Urgent</span>
        </div>
        <div class="ad-legend-item" data-series="normal">
          <span class="ad-legend-indicator ad-legend-box--secondary"></span>
          <span>Normal / Low</span>
        </div>
      </div>
      <div class="ad-chart-wrapper">
        <div class="ad-chart-tooltip js-bar-tooltip hidden">
          <div class="ad-tooltip-date js-bar-date">Oct 1</div>
          <div class="ad-tooltip-row">
            <span class="ad-tooltip-dot ad-bg-primary"></span>
            <span>High / Urgent:</span>
            <strong class="js-bar-val-high">1,200</strong>
          </div>
          <div class="ad-tooltip-row">
            <span class="ad-tooltip-dot ad-bg-secondary"></span>
            <span>Normal / Low:</span>
            <strong class="js-bar-val-normal">600</strong>
          </div>
        </div>
        <div class="ad-bar-visual">
          <div class="ad-bar-group" data-date="Oct 1" data-high="1,200" data-normal="600">
            <div class="ad-bar-top" style="height: 35%;"></div>
            <div class="ad-bar-bottom" style="height: 25%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 5" data-high="1,800" data-normal="900">
            <div class="ad-bar-top" style="height: 55%;"></div>
            <div class="ad-bar-bottom" style="height: 35%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 7" data-high="2,400" data-normal="1,100">
            <div class="ad-bar-top" style="height: 70%;"></div>
            <div class="ad-bar-bottom" style="height: 45%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 9" data-high="2,500" data-normal="1,200">
            <div class="ad-bar-top" style="height: 60%;"></div>
            <div class="ad-bar-bottom" style="height: 40%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 11" data-high="3,100" data-normal="1,500">
            <div class="ad-bar-top" style="height: 85%;"></div>
            <div class="ad-bar-bottom" style="height: 50%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 13" data-high="1,400" data-normal="700">
            <div class="ad-bar-top" style="height: 40%;"></div>
            <div class="ad-bar-bottom" style="height: 25%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 17" data-high="3,200" data-normal="1,600">
            <div class="ad-bar-top" style="height: 75%;"></div>
            <div class="ad-bar-bottom" style="height: 45%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 19" data-high="2,200" data-normal="1,100">
            <div class="ad-bar-top" style="height: 65%;"></div>
            <div class="ad-bar-bottom" style="height: 40%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 21" data-high="2,600" data-normal="1,300">
            <div class="ad-bar-top" style="height: 80%;"></div>
            <div class="ad-bar-bottom" style="height: 50%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 25" data-high="3,100" data-normal="1,550">
            <div class="ad-bar-top" style="height: 90%;"></div>
            <div class="ad-bar-bottom" style="height: 55%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 27" data-high="3,500" data-normal="1,750">
            <div class="ad-bar-top" style="height: 95%;"></div>
            <div class="ad-bar-bottom" style="height: 60%;"></div>
          </div>
          <div class="ad-bar-group" data-date="Oct 31" data-high="2,900" data-normal="1,450">
            <div class="ad-bar-top" style="height: 80%;"></div>
            <div class="ad-bar-bottom" style="height: 50%;"></div>
          </div>
        </div>
      </div>
      <div class="ad-x-axis">
        <span>Oct 1</span><span>5</span><span>7</span><span>9</span><span>11</span><span>13</span><span>17</span><span>19</span><span>21</span><span>25</span><span>27</span><span>Oct 31</span>
      </div>
    </div>
  </div>
</div>

<div class="sidebar optional js-activity-sidebar">
  <div class="ad-activity-header">
    <div class="ad-activity-title-group">
      <h2><%- @T('Activity Stream') %></h2>
      <span class="ad-live-pill"><span class="ad-live-dot"></span> LIVE</span>
    </div>
    <button class="ad-activity-close-btn js-toggle-activity-stream" title="Close Activity Stream" aria-label="Close">&times;</button>
  </div>
  <div class="activity-entries js-activityContent"></div>
</div>
