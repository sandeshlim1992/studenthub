# Copy to e2e/.env (git-ignored) and fill in the passwords. Never commit the real values.
STUDENTHUB_BASE_URL=http://localhost:3000

# A student (customer) the test signs in as. It raises, follows and closes one [TEST] ticket.
STUDENTHUB_STUDENT_LOGIN=student@example.com
STUDENTHUB_STUDENT_PASSWORD=

# Staff who answer over the API (web messages, an internal note, state changes) and delete the
# [TEST] ticket afterwards. Needs access to the team new student tickets land in and may delete
# tickets, so an admin.
STUDENTHUB_STAFF_LOGIN=admin@example.com
STUDENTHUB_STAFF_PASSWORD=
