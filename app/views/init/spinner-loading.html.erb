<%
  # Student Hub: the loading screen in the application colour (Administration → Branding),
  # with three dots in the college colours (LSST, UKBC, FSB). The setting only accepts
  # #rrggbb colours dark enough for white text; anything else falls back to the default.
  studenthub_app_color = Setting.get('studenthub_app_color').to_s
  studenthub_app_color = Studenthub::Theme::Setup::DEFAULT_APP_COLOR if !studenthub_app_color.match?(%r{\A#[0-9a-fA-F]{6}\z})
%>
<style>
body,
html,
#loading-app,
#app[data-loaded="true"] {
  height: 100%;
}
html {
  background-color: var(--background-primary);
}
body,
html {
  margin: 0;
  font-family: 'Fira Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 16px;
  line-height: 21px;
}
#loading-app {
  --sh-loading-app: <%= studenthub_app_color %>;

  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.25rem;
  overflow: hidden;
  background-color: var(--sh-loading-app);
  background-image: radial-gradient(120% 90% at 85% 0%, color-mix(in srgb, var(--sh-loading-app) 90%, #ffffff), var(--sh-loading-app) 60%);
  color: #ffffff;
  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.loading-animation {
  display: flex;
  gap: 0.75rem;
}
.loading-animation.error {
  filter: blur(1px);
  opacity: 0.6;
}
.loading-animation.error * {
  animation: none !important;
}
.loading-dot {
  width: 1rem;
  height: 1rem;
  border-radius: 50%;
  box-shadow: 0 0 0 2px #ffffff;
  animation: loadingDot 1.2s ease-in-out infinite both;
}
.loading-dot.lsst { background-color: #ef4d5f; }
.loading-dot.ukbc { background-color: #3fb26a; animation-delay: 0.16s; }
.loading-dot.fsb { background-color: #5b8cf5; animation-delay: 0.32s; }
@keyframes loadingDot {
  0%, 80%, 100% { transform: translateY(0) scale(0.85); opacity: 0.8; }
  40% { transform: translateY(-0.5rem) scale(1); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .loading-dot { animation: none; }
}
.loading-name {
  /* the left padding balances the letter-spacing after the last letter */
  padding-inline-start: 0.32em;
  font-size: 0.8125rem;
  font-weight: 800;
  letter-spacing: 0.32em;
  text-transform: uppercase;
}
.loading-sr-text {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
.loading-failed {
  /* below the dots and the name, without moving them off centre */
  position: absolute;
  top: calc(50% + 3.25rem);
  opacity: 0;
  max-width: 18rem;
  text-align: center;
  font-size: 0.875rem;
  font-weight: 600;
  transition: opacity 0.5s;
}
.loading-failed.active {
  opacity: 1;
}
.noscript-message {
  max-width: 18rem;
  text-align: center;
  font-weight: 600;
}
</style>
<div id="loading-app">
  <div class="loading-animation" aria-hidden="true">
    <span class="loading-dot lsst"></span>
    <span class="loading-dot ukbc"></span>
    <span class="loading-dot fsb"></span>
  </div>
  <span class="loading-name" aria-hidden="true">Student Hub</span>

  <div class="loading-sr-text">
    <%= Translation.translate(local_assigns[:locale], 'Loading…') %>
  </div>
  <div class="loading-failed" aria-hidden="true">
    <%= Translation.translate(local_assigns[:locale], 'Loading failed, please try again later.') %>
  </div>
  <noscript>
    <div class="noscript-message">
      <%= Translation.translate(local_assigns[:locale], 'Turn on JavaScript to use Student Hub.') %>
    </div>
  </noscript>
</div>
