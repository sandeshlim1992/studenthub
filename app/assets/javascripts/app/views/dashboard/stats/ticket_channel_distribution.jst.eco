<div class="ad-card">
  <div class="ad-card-header">
    <span class="ad-card-title"><%- @T('Channel Distribution') %></span>
    <div class="ad-card-icon">
      <%- @Icon('card-list') %>
    </div>
  </div>
  <div class="ad-channel-list">
    <% for id, channel of (@StatsTicketChannelDistribution?.channels || {}): %>
      <div class="ad-channel-row">
        <div class="ad-channel-info">
          <%- @Icon(channel.icon, 'ad-channel-icon') %>
          <span class="ad-channel-name"><%- channel.sender %></span>
        </div>
        <div class="ad-channel-bar-wrapper">
          <div class="ad-channel-track" title="Inbound: <%- channel.inbound_in_percent %>% | Outbound: <%- channel.outbound_in_percent %>%">
            <div class="ad-channel-fill-inbound" style="width: <%- channel.inbound_in_percent %>%"></div>
            <div class="ad-channel-fill-outbound" style="width: <%- channel.outbound_in_percent %>%"></div>
          </div>
          <span class="ad-channel-percentage"><%- channel.overal_percentage %>%</span>
        </div>
      </div>
    <% end %>
  </div>
</div>
