<div class="ad-card">
  <div class="ad-card-header">
    <span class="ad-card-title"><%- @T('Assigned') %></span>
    <div class="ad-card-icon">
      <%- @Icon('total-tickets') %>
    </div>
  </div>
  <div class="ad-card-value">
    <%- @StatsTicketLoadMeasure?.own || 0 %> / <%- @StatsTicketLoadMeasure?.total || 0 %>
  </div>
  <div class="ad-card-subtitle">
    <%- @T('Tickets assigned to me: %s of %s', @StatsTicketLoadMeasure?.own || 0, @StatsTicketLoadMeasure?.total || 0) %>
  </div>
  <div class="ad-card-detail">
    <%- @T('Average: %s', @StatsTicketLoadMeasure?.average_per_agent || 0) %>
  </div>
</div>
