<div class="ad-card">
  <div class="ad-card-header">
    <span class="ad-card-title"><%- @T('My tickets in process') %></span>
    <div class="ad-card-icon">
      <%- @Icon('in-process') %>
    </div>
  </div>
  <div class="ad-card-value">
    <%- @StatsTicketInProcess?.percent || 0 %>%
  </div>
  <div class="ad-card-subtitle">
    <%- @T('%s% are currently in process', @StatsTicketInProcess?.percent || 0) %>
  </div>
  <div class="ad-card-detail">
    <%- @T('Average: %s%', @StatsTicketInProcess?.average_per_agent || 0) %>
  </div>
</div>
