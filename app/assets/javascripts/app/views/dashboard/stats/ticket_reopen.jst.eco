<div class="ad-card">
  <div class="ad-card-header">
    <span class="ad-card-title"><%- @T('Reopening rate') %></span>
    <div class="ad-card-icon">
      <%- @Icon('reopening') %>
    </div>
  </div>
  <div class="ad-card-value">
    <%- @StatsTicketReopen?.percent || 0 %>%
  </div>
  <div class="ad-card-subtitle">
    <%- @T('%s% have been reopened', @StatsTicketReopen?.percent || 0) %>
  </div>
  <div class="ad-card-detail">
    <%- @T('Average: %s%', @StatsTicketReopen?.average_per_agent || 0) %>
  </div>
</div>
